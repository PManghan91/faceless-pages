---
  <main class="page">
    <section class="panel">
      <p class="eyebrow">BriefPicks utility page</p>
      <h1>TikTok Callback Parked</h1>
      <p>Direct TikTok OAuth is currently parked. BriefPicks publishing does not use this page right now.</p>
      <p class="muted">If direct TikTok OAuth is resumed, register this exact callback URL first: <code>https://briefpicks.com/tiktok-callback.html</code></p>
      <p id="response-line" class="muted"></p>
      <p id="error-line" class="error"></p>
      <p><a class="button" href="/">Back to BriefPicks</a></p>
    </section>
  </main>

  <script>
    const params = new URLSearchParams(window.location.search);
    const error = params.get('error') || '';
    const description = params.get('error_description') || '';
    const hadCallbackData = window.location.search || window.location.hash;

    if (hadCallbackData) {
      document.getElementById('response-line').textContent = 'A TikTok authorization response was received but discarded because direct OAuth is parked.';
      window.history.replaceState(null, document.title, window.location.pathname);
    }
    document.getElementById('error-line').textContent = error ? `Error: ${error} ${description}` : '';
  </script>
